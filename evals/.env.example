# Copy this file to evals/.env and fill in the keys you have.
# evals/.env is gitignored — never commit real keys.
# Every key below is OPTIONAL. Offline mode needs none of them, and live mode
# runs on arXiv alone with none of them. Add keys only for the sources you want.

# OpenAlex — free key, recommended for the `openalex` live source.
# Get one instantly at https://openalex.org/  (Account -> API key).
# Without it, OpenAlex throttles you to a tiny daily allowance.
OPENALEX_API_KEY=

# Hugging Face — optional; only raises enrichment rate limits (enrichment is
# not used by the ranking eval, so you can leave this blank).
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Semantic Scholar — optional; used for the `semantic_scholar` live source.
# Works without a key on a shared pool (best-effort). Request a key at
# https://www.semanticscholar.org/product/api  (note: not granted to
# free-domain emails since 2024, so most users run keyless).
SEMANTIC_SCHOLAR_API_KEY=

# Anthropic — optional; only if you later eval LLM-powered suggestions/rerank.
# Get one at https://console.anthropic.com/  (paid).
ANTHROPIC_API_KEY=

# GitHub — optional; only if `git clone` in live mode hits rate limits.
# Public repos clone without any token.
GITHUB_TOKEN=
