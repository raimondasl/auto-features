<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>RepoRadar — Research Radar</title>
<style>
  :root {
    --bg: #f6f8fa; --card: #ffffff; --fg: #1f2328; --muted: #656d76;
    --border: #d0d7de; --accent: #0969da; --good: #1a7f37;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --card: #161b22; --fg: #e6edf3; --muted: #8b949e;
      --border: #30363d; --accent: #4493f8; --good: #3fb950;
    }
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    max-width: 760px; margin: 0 auto; padding: 2.5rem 1rem 4rem;
    line-height: 1.6; color: var(--fg); background: var(--bg);
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1 { font-size: 2rem; margin: 0 0 .25rem; }
  .sub { color: var(--muted); margin-bottom: 2rem; }
  ul.editions { list-style: none; padding: 0; margin: 0; }
  li.edition {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: .9rem 1.1rem; margin: .6rem 0; display: flex; align-items: baseline;
    justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  }
  li.edition .date { font-weight: 700; font-size: 1.05rem; }
  li.edition .counts { color: var(--muted); font-size: .9rem; }
  li.edition .counts .picks { color: var(--good); font-weight: 700; }
  .empty { color: var(--muted); font-style: italic; padding: 1.5rem 0; }
  footer { margin-top: 3rem; text-align: center; color: var(--muted); font-size: .85rem;
    border-top: 1px solid var(--border); padding-top: 1.2rem; }
</style>
</head>
<body>
<h1>Research Radar</h1>
<div class="sub">arXiv papers ranked for this repository, updated automatically by
  <a href="https://github.com/raimondasl/auto-features">RepoRadar</a>.
  Last built {{ generated_at }}.</div>

{% if entries %}
<ul class="editions">
  {% for e in entries %}
  <li class="edition">
    <span class="date"><a href="{{ e.file }}">{{ e.date }}</a></span>
    <span class="counts"><span class="picks">{{ e.top_picks }}</span> top picks
      &middot; {{ e.total_scored }} scored &middot; run #{{ e.run_id }}</span>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">No digests archived yet.</p>
{% endif %}

<footer>
  Generated by <strong><a href="https://github.com/raimondasl/auto-features">RepoRadar</a></strong>
</footer>
</body>
</html>
